# Database
DATABASE_URL=postgresql://groundpoint:password@localhost:5432/groundpoint_dev

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=groundpoint-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# JWT Secrets (generate with: openssl genrsa -out private.pem 2048)
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_CONNECT_CLIENT_ID=ca_your_client_id_here
STRIPE_CONNECT_REDIRECT_URI=http://localhost:3000/connect/callback

# Platform Fee
PLATFORM_FEE_PERCENT=5
PLATFORM_FIXED_FEE=0.50

# Application URLs
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Email Service
EMAIL_API_KEY=your_email_api_key_here
EMAIL_FROM_ADDRESS=noreply@groundpoint.dev
EMAIL_FROM_NAME=GroundPoint

# Admin
ADMIN_EMAIL=admin@groundpoint.dev

# Logging
LOG_LEVEL=debug

# Worker Queues
THUMBNAIL_QUEUE_NAME=thumbnail-generation
PAYOUT_QUEUE_NAME=payout-processing
EMAIL_QUEUE_NAME=email-notifications
