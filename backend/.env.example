# Database
DATABASE_URL="postgresql://user:password@localhost:5432/groundpoint"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Email (for verification and password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=password
SMTP_FROM=noreply@example.com

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=groundpoint-uploads

# S3-Compatible Storage (MinIO, etc.)
# Leave blank for AWS S3, or set for MinIO/custom S3-compatible storage
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# S3 Upload/Download Configuration
S3_UPLOAD_EXPIRATION=600    # 10 minutes in seconds
S3_DOWNLOAD_EXPIRATION=3600 # 1 hour in seconds

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload Limits
MAX_FILE_SIZE=52428800      # 50 MB in bytes
